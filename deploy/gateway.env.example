# /opt/forge/gateway.env — gateway configuration for api.llmfa.st
ADDR=:8080
ADMIN_TOKEN=change-me-long-random
STORE=/opt/forge/forge-store.json
MODELS_DIR=/opt/forge/models
ENGINE_BIN=/opt/forge/engine/forge-engine
ADMIN_DIR=/opt/forge/admin/dist
ADMIN_URL=https://llmfa.st/app/admin/ui
SITE_DIR=/opt/forge/site
MAX_INFLIGHT=16
# OpenRouter provider document
PROVIDER_SLUG=llmfast
QUANTIZATION=int8
DATACENTER_COUNTRY=US
CAP_PROMPT_TPM=600000
CAP_COMPLETION_TPM=60000
CAP_RPM=600
ZDR=true
# GPU: total VRAM in MB so "auto" knows what fits (omit on CPU-only boxes)
#GPU_MEM_MB=24576
# HF_TOKEN=hf_... (only for gated repos)
