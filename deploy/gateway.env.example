# /opt/llmfast/gateway.env — gateway configuration for api.llmfa.st
ADDR=:8080
ADMIN_TOKEN=change-me-long-random
STORE=/opt/llmfast/llmfast-store.json
MODELS_DIR=/opt/llmfast/models
ENGINE_BIN=/opt/llmfast/engine/llmfast-engine
ADMIN_DIR=/opt/llmfast/admin/dist
ADMIN_URL=https://app.llmfa.st/admin/ui
SITE_DIR=/opt/llmfast/site
MAX_INFLIGHT=16
# Passed through to every engine. Defaults to physical cores; hyperthreads add a barrier
# participant per layer without adding memory bandwidth, so more is usually slower.
#THREADS=20
# Multi-token-prediction self-speculation: tokens the model's own MTP head drafts per step.
# Decode is memory-bound once the kernels are right, and speculation is the only lever that
# beats that ceiling -- it emits several tokens per pass over the weights. The dashboard shows
# the acceptance rate next to each engine; 0 disables.
#MTP_K=2
# Origins allowed to send the session cookie cross-site (dev only; production is same-origin).
# Everything else keeps the wildcard CORS header, which is all a bearer-key client needs.
#ALLOWED_ORIGINS=http://localhost:5173
# OpenRouter provider document
PROVIDER_SLUG=llmfast
QUANTIZATION=int8
DATACENTER_COUNTRY=US
CAP_PROMPT_TPM=600000
CAP_COMPLETION_TPM=60000
CAP_RPM=600
ZDR=true
# GPU: total VRAM in MB so "auto" knows what fits (omit on CPU-only boxes)
#GPU_MEM_MB=24576
# HF_TOKEN=hf_... (only for gated repos)
