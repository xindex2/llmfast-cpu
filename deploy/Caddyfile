# TLS + routing for llmfa.st. Caddy gets certificates automatically.
#
# The gateway serves everything itself (one process = site + console + admin + API):
#   llmfa.st           → marketing site (SITE_DIR)
#   llmfa.st/app       → the customer console (sign-up, keys, usage, credits, playground, docs)
#   llmfa.st/admin/ui  → the operator console, behind the admin token
#   llmfa.st/v1/*      → the API, so https://llmfa.st/v1 works as a base URL
#   llmfa.st/models    → the OpenRouter provider document
#   api.llmfa.st       → the same API on its own hostname (what OpenRouter is pointed at)
#   app.llmfa.st       → redirect to llmfa.st/app (the console used to live here)
# Caddy is only TLS + compression in front of it.

llmfa.st, www.llmfa.st {
	encode zstd gzip
	reverse_proxy localhost:8080 {
		flush_interval -1      # stream SSE tokens immediately
		transport http {
			read_timeout 10m   # long generations
		}
	}
}

app.llmfa.st {
	redir https://llmfa.st/app{uri} permanent
}

api.llmfa.st {
	encode zstd gzip
	reverse_proxy localhost:8080 {
		flush_interval -1
		transport http {
			read_timeout 10m
		}
	}
}
