[Unit]
Description=Forge gateway (api.llmfa.st)
After=network-online.target

[Service]
User=forge
WorkingDirectory=/opt/forge/gateway
EnvironmentFile=/opt/forge/gateway.env
ExecStart=/opt/forge/gateway/forge-gateway
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
